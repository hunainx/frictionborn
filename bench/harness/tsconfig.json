{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/components/ui/noise-field": ["../../registry/items/noise-field/noise-field.tsx"],
      "@/components/ui/mesh-gradient": ["../../registry/items/mesh-gradient/mesh-gradient.tsx"],
      "@/components/ui/particle-field": ["../../registry/items/particle-field/particle-field.tsx"],
      "@/components/ui/text-reveal": ["../../registry/items/text-reveal/text-reveal.tsx"],
      "@/components/ui/flame-switch": ["../../registry/items/flame-switch/flame-switch.tsx"],
      "@/components/ui/ember-badge": ["../../registry/items/ember-badge/ember-badge.tsx"],
      "@/components/ui/light-leak-tabs": ["../../registry/items/light-leak-tabs/light-leak-tabs.tsx"],
      "@/components/ui/temper-slider": ["../../registry/items/temper-slider/temper-slider.tsx"],
      "@/components/ui/match-progress": ["../../registry/items/match-progress/match-progress.tsx"],
      "@/components/ui/fuse-toast": ["../../registry/items/fuse-toast/fuse-toast.tsx"],
      "@/components/ui/flint-button": ["../../registry/items/flint-button/flint-button.tsx"],
      "@/components/ui/hold-to-confirm": ["../../registry/items/hold-to-confirm/hold-to-confirm.tsx"],
      "@/components/ui/eclipse-switch": ["../../registry/items/eclipse-switch/eclipse-switch.tsx"],
      "@/components/ui/firework-rating": ["../../registry/items/firework-rating/firework-rating.tsx"],
      "@/components/ui/ash-text": ["../../registry/items/ash-text/ash-text.tsx"],
      "@/components/ui/lantern-sky": ["../../registry/items/lantern-sky/lantern-sky.tsx"],
      "@/components/ui/magnetic-button": ["../../registry/items/magnetic-button/magnetic-button.tsx"],
      "@/components/ui/scroll-reveal": ["../../registry/items/scroll-reveal/scroll-reveal.tsx"],
      "@/components/ui/sticky-scroll-story": ["../../registry/items/sticky-scroll-story/sticky-scroll-story.tsx"],
      "@/components/ui/marquee": ["../../registry/items/marquee/marquee.tsx"],
      "@/components/ui/smooth-scroll": ["../../registry/items/smooth-scroll/smooth-scroll.tsx"],
      "@/components/ui/distortion-image": ["../../registry/items/distortion-image/distortion-image.tsx"],
      "@/components/ui/ambient-hero": ["../../registry/items/ambient-hero/ambient-hero.tsx"],
      "@/components/ui/scroll-showcase": ["../../registry/items/scroll-showcase/scroll-showcase.tsx"],
      "@/components/ui/ember-core": ["../../registry/items/ember-core/ember-core.tsx"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}

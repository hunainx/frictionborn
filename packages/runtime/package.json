{
  "name": "@frictionborn/runtime",
  "version": "0.1.0",
  "description": "Shared frame loop, capability tiers and WebGL context budget for Frictionborn Motion components",
  "keywords": [
    "react",
    "motion",
    "animation",
    "webgl",
    "shadcn",
    "reduced-motion",
    "frictionborn"
  ],
  "type": "module",
  "author": "Frictionborn",
  "license": "MIT",
  "homepage": "https://github.com/hunainx/frictionborn#readme",
  "bugs": {
    "url": "https://github.com/hunainx/frictionborn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunainx/frictionborn.git",
    "directory": "packages/runtime"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-server": "./dist/server.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./gl": {
      "types": "./dist/gl/surface.d.mts",
      "import": "./dist/gl/surface.mjs",
      "default": "./dist/gl/surface.mjs"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.mts",
      "import": "./dist/canvas/index.mjs",
      "default": "./dist/canvas/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

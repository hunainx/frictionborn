{
  "name": "frictionborn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "echo \"dev: docs site + harness (M1/M2)\"",
    "build": "turbo run build",
    "test": "vitest run",
    "bench": "echo \"bench: Playwright bench (step 3)\"",
    "size": "size-limit",
    "lint": "eslint .",
    "meta": "echo \"meta: catalog + evidence (step 2)\"",
    "registry:build": "echo \"registry:build: shadcn build (step 5)\""
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@size-limit/preset-small-lib": "11.2.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "11.2.0",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "size-limit": [
    {
      "name": "@frictionborn/runtime (core)",
      "path": "packages/runtime/dist/index.mjs",
      "limit": "5 KB",
      "gzip": true,
      "ignore": ["react", "react-dom"]
    },
    {
      "name": "@frictionborn/runtime/gl",
      "path": "packages/runtime/dist/gl/surface.mjs",
      "limit": "3 KB",
      "gzip": true
    }
  ]
}

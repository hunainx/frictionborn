{
  "name": "frictionborn",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hunainx/frictionborn.git"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "echo \"dev: docs site + harness (M1/M2)\"",
    "build": "turbo run build",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/run-bench.ts",
    "bench:release": "node --experimental-strip-types bench/run-bench.ts --release",
    "size": "node --experimental-strip-types scripts/build-sizes.ts",
    "lint": "eslint . && node --experimental-strip-types scripts/check-provenance.ts && node --experimental-strip-types scripts/check-copy.ts && node --experimental-strip-types scripts/check-shipped-code.ts",
    "meta": "node --experimental-strip-types scripts/validate-meta.ts && node --experimental-strip-types scripts/merge-evidence.ts && node --experimental-strip-types scripts/build-catalog.ts",
    "meta:check": "node --experimental-strip-types scripts/validate-meta.ts && node --experimental-strip-types scripts/merge-evidence.ts --check && node --experimental-strip-types scripts/build-catalog.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "registry:build": "node --experimental-strip-types scripts/build-registry.ts",
    "smoke:install": "node --experimental-strip-types scripts/smoke-install.ts",
    "fresh-apps": "node --experimental-strip-types scripts/fresh-apps.ts",
    "fresh-apps:no-gl": "node --experimental-strip-types scripts/fresh-apps.ts --no-gl",
    "lighthouse": "node --experimental-strip-types bench/lighthouse/run.ts",
    "docs:dev": "pnpm --filter @frictionborn/docs dev",
    "docs:build": "pnpm --filter @frictionborn/docs build",
    "docs:verify": "node --experimental-strip-types scripts/verify-docs.ts",
    "parity:v2": "playwright test --config playwright.parity.config.ts",
    "parity:v3": "playwright test --config playwright.parity-v3.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@frictionborn/runtime": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "11.2.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "11.2.0",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "3.2.7"
  },
  "size-limit": [
    {
      "name": "@frictionborn/runtime (core)",
      "path": "packages/runtime/dist/index.mjs",
      "limit": "5 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "@frictionborn/runtime/gl",
      "path": "packages/runtime/dist/gl/surface.mjs",
      "limit": "3 KB",
      "gzip": true
    }
  ]
}
